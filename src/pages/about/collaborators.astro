---

<Layout>
    <div class="max-w-screen h-full flex flex-col items-center justify-around">
        {
            sections.map((section) => (
                <>
                    <h2 class="text-4xl p-4 uppercase text-center">{section.title}</h2>
                    <div class="flex flex-row flex-wrap justify-around">
                        {section.items.map((member) => (
                            <div class="flex flex-col m-10">
                                <CollabFrame
                                    src={member.photo}
                                    alt={member.alt}
                                    loading="lazy"
                                />
                                <p class="flex justify-center font-semibold">
                                    {member.url ? (
                                        <a
                                            href={member.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="hover:underline hover:text-purple"
                                        >
                                            {member.name}
                                        </a>
                                    ) : (
                                        member.name
                                    )}
                                </p>
                            </div>
                        ))}
                    </div>
                </>
            ))
        }
    </div>
</Layout>
