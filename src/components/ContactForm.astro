---

---
<input type="hidden" name="join_mailing_list" value="No" id="hidden-mailing-list">
<form
    name="Sound Sorcery Form"
    method="POST"
    netlify-honeypot="bot-field"
    data-netlify="true"
    action="/success/"
    class="bg-green p-4 md:p-8 rounded-lg shadow-md w-full mx-auto"
>
    <input
        type="hidden"
        name="subject"
        value="New Sound Sorcery Form Submission"
    />

    <div hidden>
        <input name="bot-field" />
    </div>

    <div class="mb-4 flex flex-col md:flex-row md:items-center">
        <label
            for="name"
            class="w-full md:w-1/12 text-light-pink text-sm font-bold md:text-right pr-0 md:pr-4 uppercase mb-1 md:mb-0"
        >
            Name
        </label>
        <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full md:w-11/12 bg-mint-green rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-pink"
        />
    </div>

    <div class="mb-4 flex flex-col md:flex-row md:items-center">
        <label
            for="email"
            class="w-full md:w-1/12 text-light-pink text-sm font-bold md:text-right pr-0 md:pr-4 uppercase mb-1 md:mb-0"
        >
            Email
        </label>
        <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full md:w-11/12 bg-mint-green rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-pink"
        />
    </div>

    <div class="mb-4 flex flex-col md:flex-row md:items-center">
        <label
            for="type"
            class="w-full md:w-1/12 text-light-pink text-sm font-bold md:text-right pr-0 md:pr-4 uppercase mb-1 md:mb-0"
        >
            Type
        </label>
        <select
            id="type"
            name="type"
            required
            class="w-full md:w-11/12 bg-mint-green rounded-lg p-2.5 focus:outline-none focus:ring-2 focus:ring-pink"
        >
            <option value="general enquiry">General Enquiry</option>
            <option value="sponsor enquiry">Sponsor Enquiry</option>
        </select>
    </div>

    <div class="mb-6 flex flex-col md:flex-row">
        <label
            for="message"
            class="w-full md:w-1/12 text-light-pink text-sm font-bold md:text-right pr-0 md:pr-4 uppercase mb-1 md:mb-0 md:pt-2"
        >
            Message
        </label>
        <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full md:w-11/12 bg-mint-green rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-pink min-h-48"
        ></textarea>
    </div>

    <div class="mb-6 flex justify-center">
        <input
            type="checkbox"
            id="mailing-list"
            name="join_mailing_list"
            value="yes"
            class="mr-2 h-5 w-5 rounded border-mint-green text-pink focus:ring-pink"
            onchange="document.getElementById('hidden-mailing-list').value = this.checked ? 'Yes' : 'No'"
        />
        <label
            for="mailing-list"
            class="text-light-pink text-sm font-bold uppercase"
        >
            Join the mailing list!
        </label>
    </div>

    <div class="flex justify-center">
        <button
            type="submit"
            class="hover:bg-dark-green hover:text-white px-6 py-2 rounded-lg bg-mint-green text-dark-green uppercase"
        >
            Submit
        </button>
    </div>
</form>
