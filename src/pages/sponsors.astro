---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import creativeAustralia from "../assets/images/logos/creativeAus.webp";
import citySyd from "../assets/images/logos/cityOfSyd.webp";
import heapsNormal from "../assets/images/logos/HN.webp";
import beardedTit from "../assets/images/logos/BT.webp";
import IWCblack from "../assets/images/logos/IWCblack.webp";
import pleasureClub from "../assets/images/logos/PleasureClub.webp";
import SBI from "../assets/images/logos/SBI.webp";
import sydneyPosters from "../assets/images/logos/sydneyPosters.webp";
---

<Layout>
    <div class="w-full flex flex-col items-center justify-center p-8 gap-8">
        <h2 class="max-w-screen text-4xl p-4 text-center uppercase">Sponsors</h2>

        <div class="w-full max-w-6xl grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 items-center justify-items-center py-6">
            <div class="flex items-center justify-center p-4">
                <Image src={citySyd} alt="City of Sydney" loading="eager" width={300} height={120} class="max-h-24 object-contain" />
            </div>

            <div class="flex items-center justify-center p-4">
                <Image src={IWCblack} alt="Inner West Council" loading="eager" width={220} height={120} class="max-h-24 object-contain" />
            </div>

            <div class="flex items-center justify-center p-4">
                <Image src={SBI} alt="Sydney Band Instruments" loading="eager" width={220} height={120} class="max-h-24 object-contain" />
            </div>

            <div class="flex items-center justify-center p-4">
                <Image src={sydneyPosters} alt="Sydney Posters" loading="eager" width={220} height={120} class="max-h-24 object-contain" />
            </div>

            <div class="flex items-center justify-center p-4">
                <Image src={pleasureClub} alt="Pleasure Club" loading="eager" width={220} height={120} class="max-h-24 object-contain" />
            </div>
        </div>

        <h2 class="text-3xl font-semibold text-center pt-6">Past Sponsors</h2>

        <div class="w-full max-w-4xl grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 items-center justify-items-center py-6">
            <div class="flex items-center justify-center p-4">
                <Image src={creativeAustralia} alt="Creative Australia" loading="eager" width={300} height={120} class="max-h-24 object-contain" />
            </div>

            <div class="flex items-center justify-center p-4">
                <Image src={beardedTit} alt="The Bearded Tit" loading="eager" width={220} height={120} class="max-h-24 object-contain" />
            </div>

            <div class="flex items-center justify-center p-4">
                <Image src={heapsNormal} alt="Heaps Normal" loading="eager" width={220} height={120} class="max-h-24 object-contain" />
            </div>
        </div>

        <p class="text-center">Keen to become a sponsor?</p>
        <div class="flex justify-center">
            <button type="submit" class="bg-pink text-white px-8 py-4 rounded-lg hover:bg-dark-pink focus:outline-none uppercase">
                <a href="/Sound-Sorcery-Partnership-Opportunities-2025.pdf" rel="nofollow noopener noreferrer" referrerpolicy="no-referrer" download="Sound-Sorcery-Partnership-Opportunities-2025.pdf" class="font-semibold pdf-link">Download our partnership document</a>
            </button>
        </div>
    </div>
</Layout>
