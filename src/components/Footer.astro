---
import Logo from "./Logo.astro";
---

<footer class="bg-pink relative">
    <div class="flex flex-col-reverse sm:flex-row px-10 pb-2 gap-4 decoration-mauve sm:justify-between sticky bottom-0">
        <div class="max-w-screen flex flex-col gap-3 sm:justify-around sm:items-start items-center">
            <h3 class="text-justify whitespace-pre-line ">
                Sound Sorcery acknowledges the Gadigal people of the Eora Nation as the traditional owners of the land on which we meet. 
                We pay our respects to Elders past and present. Sovereignty was never ceded.
            </h3>
            <p class="text-xs text-start">
                Website by <a
                    href="https://ashsahu.com"
                    target="_blank"
                    class="font-medium text-mauve">Ash Sahu</a
                >
            </p>
        </div>
        <div class="flex flex-col flex-nowrap items-center py-4">
            <div class="w-[90px] h-[90px] pb-10">
                <Logo width={100} height={100} />
            </div>
            <a href="/contact" class="text-mauve font-semibold text-nowrap"> Contact Us</a>
        </div>
    </div>
</footer>
