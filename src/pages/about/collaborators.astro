<Layout>
    <h2 class="max-w-screen text-4xl p-4 text-center uppercase">Collaborators</h2>
    <div class="max-w-screen h-full flex flex-col items-center justify-around">
        <nav class="flex flex-row flex-wrap items-center justify-center gap-2 py-4 px-6 text-center">
            {
                sections.map((section, index) => (
                    <>
                        <a
                            href={`#section-${index}`}
                            class="text-sm uppercase font-semibold hover:text-purple whitespace-nowrap"
                        >
                            {section.title}
                        </a>
                        {index < sections.length - 1 && (
                            <span class="text-sm text-pink">|</span>
                        )}
                    </>
                ))
            }
        </nav>
        {
            sections.map((section, index) => (
                <>
                    <h2
                        id={`section-${index}`}
                        class="text-2xl p-4 uppercase text-center scroll-mt-24"
                    >
                        {section.title}
                    </h2>
                    <div class="flex flex-row flex-wrap justify-around">
                        {section.items.map((member) => (
                            <div class="flex flex-col m-10">
                                <a
                                    href={member.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <CollabFrame
                                        src={member.photo}
                                        alt={member.alt}
                                        loading="lazy"
                                    />
                                </a>
                                <p class="flex justify-center font-semibold text-center">
                                    {member.url ? (
                                        <a
                                            href={member.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class=" hover:text-purple"
                                        >
                                            {member.name}
                                        </a>
                                    ) : (
                                        member.name
                                    )}
                                </p>
                            </div>
                        ))}
                    </div>
                </>
            ))
        }
    </div>
</Layout>