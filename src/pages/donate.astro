---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import donate from "../assets/images/others/donate.webp";
import Kofi from "../components/Kofi.astro";

const donation = [
    `<strong><strong>$25</strong></strong> keeps our event free for an audience member or jammer, removing financial barriers.`,
    `<strong><strong>$50</strong></strong> pays to subsidise riders for musicians so they can enjoy a beverage on the house.`,
    `<strong><strong>$100</strong></strong> pays the mentoring fee for our soundie to mentor an aspiring sound-tech.`,
    `<strong><strong>$260</strong></strong> pays for one female/gender diverse musician in the house band.`,
    `<strong><strong>$300</strong></strong> pays for the discount hire of a queer-friendly venue for a training workshop.`,
    `<strong><strong>$350</strong></strong> pays for our sound engineer to live mix one Sound Sorcery Jam.`,
    `<strong><strong>$500</strong></strong> pays for a half-day workshop mentor fee!`,
    `<strong><strong>$750</strong></strong> makes a half-day workshop possible with catering. <a href="/projects/free-workshops"><strong><strong>Learn more about our workshops!</strong></strong></a>`,
];
---

<Layout>
    <div class="w-max-screen h-full flex flex-col items-center justify-center">
        <h2 class="text-4xl p-4 uppercase">Donate</h2>
        <div
            class="flex flex-col lg:flex-row items-center gap-12 p-4 px-12 md:px-20"
        >
            <Image
                src={donate}
                alt="Sound Sorcery logo"
                class="rounded-md"
                loading="eager"
                width="500"
                height="500"
            />
            <div class="flex flex-col">
                <div class="p-4">
                    <h3 class="max-sm:text-center pb-4">
                        Help fund our future projects, events and workshops!
                    </h3>
                    {
                        donation.map((item) => (
                            <p class="max-sm:text-justify">
                                <Fragment set:html={item} />
                            </p>
                        ))
                    }
                </div>
                <div class="flex max-sm:justify-center sm:pl-4">
                    <Kofi />
                </div>
            </div>
        </div>
        <p class="flex justify-center pt-10 pb-4">
            Keen to become an Official Sponsor?
        </p>
        <div class="flex justify-center pb-10">
            <button
                type="submit"
                class="bg-pink text-white px-8 py-4 rounded-lg hover:bg-dark-pink focus:outline-none uppercase"
            >
                <a
                    href="/Sound-Sorcery-Partnership-Opportunities-2025.pdf"
                    rel="nofollow noopener noreferrer"
                    referrerpolicy="no-referrer"
                    download="Sound-Sorcery-Partnership-Opportunities-2025.pdf"
                    class="font-semibold pdf-link"
                    >Download our partnership document
                </a>
            </button>
        </div>
    </div>
</Layout>