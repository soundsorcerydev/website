---
import Layout from "../../layouts/Layout.astro";
import { getImage, Image } from "astro:assets";
import GeethaBalakrishnan from "../../assets/images/core_team/GeethaBalakrishnan.webp";
import HarriHarding from "../../assets/images/core_team/HarriHarding.webp";
import HayleyChan from "../../assets/images/core_team/HayleyChan.webp";
import KateRichards from "../../assets/images/core_team/KateRichards.webp";
import SarahHomeh from "../../assets/images/core_team/SarahHomeh.webp";
import CoreFrame from "../../components/CoreFrame.astro";

const teamMembers = [
    {
        name: "Geetha Balakrishnan",
        role: "Series Producer",
        image: GeethaBalakrishnan,
        url: "https://magickal-ms-g.com/",
    },
    {
        name: "Sarah Homeh",
        role: "Series Co-Producer",
        image: SarahHomeh,
        url: "https://www.sarahhomeh.com/",
    },
    {
        name: "Harri Harding",
        role: "Trans-Inclusivity advisor",
        image: HarriHarding,
        url: "https://heyharri.com/",
    },
    {
        name: "Hayley Chan",
        role: "Marketing & Administration Assistant",
        image: HayleyChan,
        url: "https://hayleychandrums.com/",
    },
    {
        name: "Kate Richards",
        role: "Marketing 2024",
        image: KateRichards,
        url: "https://au.linkedin.com/in/kate-richards-64602617a",
    },
];
---

<Layout>
    <h2 class="max-w-screen text-4xl p-4 text-center uppercase">Core Team</h2>
    <div
        class="flex flex-row justify-center p-8 gap-10 md:gap-22 overflow-hidden flex-wrap"
    >
        {
            teamMembers.map((member) => (
                <div class="flex flex-col items-center gap-1">
                    <CoreFrame
                        src={member.image}
                        alt={member.name}
                        url={member.url}
                    />
                    <a
                        href={member.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-purple"
                    >
                        <p class="text-center sm:text-base md:text-lg lg:text-xl">
                            {member.name} ({member.role})
                        </p>
                    </a>
                </div>
            ))
        }
    </div>
</Layout>
