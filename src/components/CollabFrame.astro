---
import { getImage, Image } from "astro:assets";
const { src, alt } = Astro.props;
const blurredPlaceholder = await getImage({
    src: src,
    format: "webp",
    width: 20,
});
---

<div class="flex justify-center">
    <div
        class="relative rounded-full overflow-hidden h-48 w-48 sm:h-56 sm:w-56 lg:w-80 lg:h-80"
    >
        <img
            src={blurredPlaceholder.src}
            class="absolute inset-0 w-full h-full object-cover blur-lg grayscale"
            alt={`Blurred ${alt}`}
            aria-hidden="true"
        />
        <Image
            src={src}
            alt={alt}
            class="relative w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-300 opacity-0"
            loading="eager"
            quality={60}
            inferSize={true}
            decoding="async" onload="this.classList.remove('opacity-0')" />
        </Image>
    </div>
</div>
